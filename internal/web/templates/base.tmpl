{{define "layout"}}<!doctype html>
<html lang="fa" dir="rtl"><head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{template "title" .}}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
  <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/styles.min.css">
  <style>body{font-family:'Vazirmatn',sans-serif}#mainNav{background:linear-gradient(rgba(0,37,64,.96),rgba(0,80,120,.9))}</style>
</head><body id="page-top">
<nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="mainNav"><div class="container px-4 px-lg-5">
  <a class="navbar-brand" href="/">{{.Site.Brand}}</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarResponsive">منو</button>
  <div class="collapse navbar-collapse" id="navbarResponsive"><ul class="navbar-nav ms-auto">
    <li class="nav-item"><a class="nav-link" href="/#about">ساعت کاری و قوانین</a></li><li class="nav-item"><a class="nav-link" href="/#classes">کلاس‌ها</a></li>
    <li class="nav-item"><a class="nav-link" href="/#events">رویدادها</a></li><li class="nav-item"><a class="nav-link" href="/#live-rankings">رده‌بندی شناگران</a></li>
  </ul>{{if .User}}<a class="btn btn-outline-light ms-3" href="/dashboard">{{with .User.FirstName}}{{value .}}{{else}}حساب کاربری{{end}}</a><a class="btn btn-link text-white" href="/auth/logout">خروج</a>{{else}}<a class="btn btn-outline-light ms-3" href="/auth/login">ورود / ثبت‌نام</a>{{end}}</div>
</div></nav>
{{template "content" .}}
<footer class="footer bg-black small text-center text-white-50"><div class="container py-4">© {{.Site.Brand}}{{if .Site.City}} — {{.Site.City}}{{end}}</div></footer>
<div class="position-fixed bottom-0 start-0 p-3" style="z-index:1080">{{template "flash" .}}</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/static/js/app.js"></script>
</body></html>{{end}}
