{{define "title"}}رزروهای من | {{.Site.Brand}}{{end}}{{define "content"}}
<div class="d-flex justify-content-between"><h3>رزروهای من</h3><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#bookingModal">رزرو جدید</button></div>
<h5 class="mt-4">رزروهای پیش رو</h5><div class="table-responsive"><table class="table bg-white"><thead><tr><th>تاریخ</th><th>ساعت</th><th>نوع</th><th>مدت</th><th>لاین</th><th>وضعیت</th><th></th></tr></thead><tbody>{{range .Upcoming}}<tr><td>{{.Date}}</td><td>{{.Time}}</td><td>{{.Type}}</td><td>{{.Duration}} دقیقه</td><td>{{with .Lane}}{{.}}{{else}}—{{end}}</td><td>{{.Status}}</td><td>{{if eq .Status "active"}}<button class="btn btn-sm btn-outline-danger js-cancel-booking" data-booking-id="{{.ID}}">لغو</button>{{end}}</td></tr>{{else}}<tr><td colspan="7" class="text-muted">رزروی وجود ندارد.</td></tr>{{end}}</tbody></table></div>
<h5 class="mt-4">رزروهای گذشته</h5><div class="table-responsive"><table class="table bg-white"><tbody>{{range .Past}}<tr><td>{{.Date}}</td><td>{{.Time}}</td><td>{{.Type}}</td><td>{{.Status}}</td></tr>{{else}}<tr><td class="text-muted">رزروی وجود ندارد.</td></tr>{{end}}</tbody></table></div>
{{end}}{{define "scripts"}}<script>document.querySelectorAll(".js-cancel-booking").forEach(btn=>btn.addEventListener("click",async()=>{if(!confirm("این رزرو لغو شود؟"))return;const res=await fetch("/api/bookings/cancel",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({booking_id:Number(btn.dataset.bookingId)})});if(res.ok){location.reload()}else{const data=await res.json();alert(data.message||data.error||"خطا در لغو رزرو")}}));</script>{{end}}
