{{define "title"}}{{.Site.Brand}} — استخر شنا{{end}}
{{define "content"}}
<header class="masthead"><div class="container px-4 px-lg-5 d-flex h-100 align-items-center justify-content-center"><div class="text-center"><h1 class="mx-auto my-0 text-uppercase">{{.Site.Brand}}</h1><h2 class="text-white-50 mx-auto mt-2 mb-5">{{.Site.Tagline}}</h2><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#bookingModal">رزرو سانس/لاین</button></div></div></header>
<section class="about-section text-center" id="about"><div class="container py-5"><h2 class="text-white mb-4">ساعت کاری و قوانین استخر</h2><p class="text-white-50">منطقه زمانی: {{.Hours.Timezone}}</p><ul class="list-unstyled text-white-50">{{range .Hours.Weekly}}<li>{{.Day}} — {{.Open}} تا {{.Close}}</li>{{end}}</ul><ul class="list-unstyled text-white-50">{{range .Hours.Rules}}<li>• {{.}}</li>{{end}}</ul></div></section>
<section class="py-5" id="facilities"><div class="container"><h3>استخرها</h3><div class="row">{{range .Pools.Pools}}<div class="col-md-6 col-lg-4 mb-4"><div class="card h-100 shadow-sm">{{if .Image}}<img src="/static/{{.Image}}" class="card-img-top" alt="{{.Name}}">{{end}}<div class="card-body"><h5>{{.Name}}</h5><p class="text-muted">{{.Description}}</p><ul class="small text-muted">{{if .Depth}}<li>عمق: {{.Depth}}</li>{{end}}{{if .Length}}<li>ابعاد/طول: {{.Length}}</li>{{end}}{{if .Temperature}}<li>دما: {{.Temperature}}</li>{{end}}{{if .SuitableFor}}<li>مناسب برای: {{.SuitableFor}}</li>{{end}}</ul><button class="btn btn-sm btn-primary js-booking-trigger" data-bs-toggle="modal" data-bs-target="#bookingModal" data-facility-slug="{{.Slug}}">رزرو سانس</button></div></div></div>{{end}}</div></div></section>
<section class="py-5 bg-light"><div class="container">{{range .Programmes.Categories}}<h4>{{.Title}}</h4><div class="row">{{range .Items}}<div class="col-md-6 col-lg-4 mb-4"><div class="card h-100 shadow-sm">{{if .Image}}<img src="/static/{{.Image}}" class="card-img-top" alt="{{.Name}}">{{end}}<div class="card-body"><h5>{{.Name}}</h5><p class="text-muted">{{.Description}}</p></div></div></div>{{end}}</div>{{end}}</div></section>
<section class="projects-section bg-white py-5" id="classes"><div class="container"><h2 class="text-center mb-5">کلاس‌ها و دوره‌ها</h2>{{range .ClassGroups}}<h4>{{.Title}}</h4><div class="row">{{range .Items}}<div class="col-md-6 col-lg-4 mb-4"><div class="class-card card h-100 shadow-sm" role="button" tabindex="0" data-slug="{{.Slug}}" data-name="{{.Name}}" data-coach="{{.Coach}}" data-time="{{.Time}}" data-capacity="{{.Capacity}}" data-price="{{.Price}}" data-price-amount="{{.PriceAmount}}" data-description="{{.Description}}">{{if .Image}}<img src="/static/{{.Image}}" alt="{{.Name}}">{{end}}<div class="card-body"><h5>{{.Name}}</h5><p class="text-muted">{{.Description}}</p><ul class="small text-muted"><li>مربی: {{.Coach}}</li><li>زمان: {{.Time}}</li><li>ظرفیت: {{.Capacity}}</li><li>هزینه: {{.Price}}</li></ul>{{range .Tags}}<span class="badge bg-info text-dark">{{.}}</span>{{end}}</div></div></div>{{end}}</div>{{end}}
<div class="modal fade" id="classDetailModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 id="classDetailModalLabel">جزئیات کلاس</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><h4 id="classModalTitle"></h4><p>مربی: <span id="classModalCoach"></span></p><p>زمان: <span id="classModalTime"></span></p><p>ظرفیت: <span id="classModalCapacity"></span></p><p>هزینه: <span id="classModalPrice"></span></p><p id="classModalDescription"></p><input type="hidden" id="classModalSlug"><button id="classModalSignupButton" class="btn btn-primary" data-authenticated="{{if .User}}1{{else}}0{{end}}" data-login-url="/auth/login?next=%2Fdashboard%2Fclasses">ثبت‌نام در این کلاس</button></div></div></div></div>
</div></section>
<section class="projects-section bg-light py-5" id="events"><div class="container"><h2 class="text-center mb-5">رویدادها و برنامه‌های ویژه</h2><div class="row">{{range .Events}}<div class="col-md-6 col-lg-4 mb-4"><div class="card h-100 shadow-sm">{{if .Image}}<img src="/static/{{.Image}}" alt="{{.Title}}">{{end}}<div class="card-body"><div class="small text-muted">{{.Date}} — {{.Time}}</div><h5>{{.Title}}</h5><p>{{.Description}}</p><p class="small">ثبت‌نام شده: {{.RegisteredCount}} نفر</p>{{if eq .State "open"}}{{if $.User}}<a class="btn btn-sm btn-primary" href="/dashboard/events#{{.Slug}}">شرکت در رویداد</a>{{else}}<a class="btn btn-sm btn-primary" href="/auth/login?next=%2Fdashboard%2Fevents">شرکت در رویداد</a>{{end}}{{end}}</div></div></div>{{end}}</div></div></section>
<section class="projects-section bg-light py-5" id="live-rankings"><div class="container"><h3 class="text-center">رده‌بندی زنده شناگران</h3><p class="text-muted small text-center">{{if .UpdatedAt}}آخرین به‌روزرسانی: {{.UpdatedAt}}{{else}}در حال حاضر امکان دریافت اطلاعات زنده وجود ندارد.{{end}}</p><div class="table-responsive"><table class="table table-striped text-center"><thead><tr><th>ردیف</th><th>نام شناگر</th><th>باشگاه</th><th>ایونت / استایل</th><th>زمان</th><th>امتیاز</th></tr></thead><tbody>{{range .Rankings}}<tr><td>{{.Rank}}</td><td>{{.Name}}</td><td>{{.Club}}</td><td>{{.Event}}</td><td>{{.Time}}</td><td>{{.Score}}</td></tr>{{end}}</tbody></table></div></div></section>
<section class="contact-section bg-black py-5" id="contact"><div class="container"><div class="row">
<div class="col-md-4 mb-3"><div class="card py-4 h-100"><div class="card-body text-center"><h4>آدرس</h4><div class="small text-black-50">{{.Site.Address}}</div></div></div></div>
<div class="col-md-4 mb-3"><div class="card py-4 h-100"><div class="card-body text-center"><h4>ایمیل</h4><a href="mailto:{{.Site.Email}}">{{.Site.Email}}</a></div></div></div>
<div class="col-md-4 mb-3"><div class="card py-4 h-100"><div class="card-body text-center"><h4>تلفن</h4><div class="small text-black-50">{{.Site.Phone}}</div></div></div></div></div>
{{if .Site.Map.EmbedURL}}<div class="ratio ratio-4x3 mt-4"><iframe src="{{.Site.Map.EmbedURL}}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>{{end}}
<div class="social d-flex justify-content-center mt-4"><a class="mx-2" href="{{.Site.Social.Instagram}}">اینستاگرام</a><a class="mx-2" href="{{.Site.Social.Telegram}}">تلگرام</a><a class="mx-2" href="{{.Site.Social.GitHub}}">گیت‌هاب</a></div></div></section>
{{template "booking-modal" .}}
{{end}}
