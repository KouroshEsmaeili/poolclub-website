{{define "layout"}}<!doctype html><html lang="fa" dir="rtl"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{template "title" .}}</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet"><link rel="stylesheet" href="/static/css/styles.min.css">
<style>body{font-family:Vazirmatn,sans-serif;background:radial-gradient(circle at top,#012b45 0%,#020b16 60%,#000 100%);min-height:100vh}.auth-wrapper{padding:6rem 1rem;min-height:100vh}.auth-card{border-radius:1rem}</style></head><body>
<header class="fixed-top p-3 bg-dark"><div class="container d-flex justify-content-between"><a class="text-white text-decoration-none" href="/">{{.Site.Brand}}</a><a class="btn btn-sm btn-outline-light" href="/">بازگشت</a></div></header>
<main class="auth-wrapper d-flex align-items-center"><div class="container">{{template "content" .}}</div></main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>{{end}}
