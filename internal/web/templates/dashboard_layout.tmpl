{{define "layout"}}<!doctype html><html lang="fa" dir="rtl"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{template "title" .}}</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet"><script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js"></script><link rel="stylesheet" href="/static/css/styles.min.css">
<style>body{font-family:Vazirmatn,sans-serif;background:#f4f6f9}.sidebar{width:240px;position:fixed;inset:0 0 0 auto;background:#0f1b2b;padding:2rem 1rem}.sidebar a{display:block;padding:.6rem .8rem;color:#b8c6d1;text-decoration:none;border-radius:.5rem}.sidebar a:hover,.sidebar a.active{background:#1f2d3b;color:#fff}.content{margin-right:240px;padding:2rem;min-height:100vh}@media(max-width:767px){.sidebar{position:static;width:100%}.content{margin-right:0}}</style></head><body>
<nav class="sidebar"><h4><a class="text-white" href="/">{{.Site.Brand}}</a></h4><p class="small text-white-50">{{value .User.FirstName}} {{value .User.LastName}}</p>
<a class="{{if eq .Active "dashboard"}}active{{end}}" href="/dashboard">داشبورد</a><a class="{{if eq .Active "bookings"}}active{{end}}" href="/dashboard/bookings">رزروهای من</a>
<a class="{{if eq .Active "events"}}active{{end}}" href="/dashboard/events">رویدادها</a><a class="{{if eq .Active "membership"}}active{{end}}" href="/dashboard/membership">اشتراک من</a>
<a class="{{if eq .Active "classes"}}active{{end}}" href="/dashboard/classes">کلاس‌های من</a><a class="{{if eq .Active "wallet"}}active{{end}}" href="/dashboard/wallet">کیف پول</a>
<a class="{{if eq .Active "profile"}}active{{end}}" href="/dashboard/profile">تنظیمات پروفایل</a><hr class="border-secondary"><form method="post" action="/auth/logout"><button class="btn btn-link text-danger text-decoration-none px-2" type="submit">خروج</button></form></nav>
<main class="content">{{template "flash" .}}{{template "content" .}}</main>{{template "booking-modal" .}}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/static/js/app.js"></script>{{template "scripts" .}}</body></html>{{end}}
{{define "scripts"}}{{end}}
