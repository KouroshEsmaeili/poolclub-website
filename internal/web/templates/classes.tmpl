{{define "title"}}کلاس‌های من | {{.Site.Brand}}{{end}}{{define "content"}}
<div class="d-flex justify-content-between"><h3>کلاس‌ها</h3><a class="btn btn-success btn-sm" href="/dashboard/wallet">کیف پول: {{.User.WalletBalance}} تومان</a></div>
{{range .ClassGroups}}<h4 class="mt-4">{{.Title}}</h4><div class="row">{{range .Items}}<div class="col-md-6 col-lg-4 mb-3"><div class="card h-100 class-card" data-slug="{{.Slug}}" data-name="{{.Name}}" data-coach="{{.Coach}}" data-time="{{.Time}}" data-capacity="{{.Capacity}}" data-price="{{.Price}}" data-price-amount="{{.PriceAmount}}" data-description="{{.Description}}">{{if .Image}}<img src="/static/{{.Image}}" alt="{{.Name}}">{{end}}<div class="card-body"><h5>{{.Name}}</h5><p>{{.Description}}</p><p class="small">{{.Coach}} — {{.Time}} — {{.Price}}</p><button class="btn btn-primary js-enroll-class" data-slug="{{.Slug}}">ثبت‌نام</button></div></div></div>{{end}}</div>{{end}}
<div class="card shadow-sm mt-4"><div class="card-body"><h5>ثبت‌نام‌های من</h5><ul class="list-group list-group-flush">{{range .Enrollments}}<li class="list-group-item"><strong>{{.ClassName}}</strong> — {{with .Coach}}{{value .}}{{end}} — {{.Price}} تومان</li>{{else}}<li class="list-group-item text-muted">هنوز در کلاسی ثبت‌نام نکرده‌اید.</li>{{end}}</ul></div></div>
{{end}}{{define "scripts"}}<script>document.querySelectorAll(".js-enroll-class").forEach(btn=>btn.addEventListener("click",async(event)=>{event.stopPropagation();const res=await fetch("/api/classes/enroll",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({class_slug:btn.dataset.slug})});const data=await res.json();if(res.ok){location.reload()}else{alert(data.message||data.error||"خطا در ثبت‌نام کلاس")}}));</script>{{end}}
