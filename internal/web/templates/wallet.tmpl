{{define "title"}}کیف پول | {{.Site.Brand}}{{end}}{{define "content"}}
<div class="d-flex justify-content-between"><h3>کیف پول</h3><span class="badge bg-success fs-6">{{.Wallet.Balance}} تومان</span></div>
<div class="card shadow-sm my-4"><div class="card-body"><h5>شارژ کیف پول</h5><form id="depositForm" class="row g-2"><div class="col"><input id="depositAmount" class="form-control" type="number" min="1" placeholder="مبلغ" required></div><div class="col-auto"><button class="btn btn-success">شارژ</button></div></form></div></div>
<div class="card shadow-sm"><div class="card-body"><h5>تراکنش‌ها</h5><div class="table-responsive"><table class="table"><thead><tr><th>زمان</th><th>شرح</th><th>نوع</th><th>مبلغ</th></tr></thead><tbody>{{range .Wallet.Transactions}}<tr><td>{{datetime .Timestamp}}</td><td>{{value .Description}}</td><td>{{.Type}}</td><td>{{.Amount}}</td></tr>{{else}}<tr><td colspan="4" class="text-muted">تراکنشی وجود ندارد.</td></tr>{{end}}</tbody></table></div></div></div>
{{end}}{{define "scripts"}}<script>document.getElementById("depositForm")?.addEventListener("submit",async(e)=>{e.preventDefault();const amount=document.getElementById("depositAmount").value;const res=await fetch("/api/wallet/deposit",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({amount})});const data=await res.json();if(res.ok){location.reload()}else{alert(data.message||data.error||"خطا در شارژ کیف پول")}});</script>{{end}}
