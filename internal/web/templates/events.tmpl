{{define "title"}}رویدادها | {{.Site.Brand}}{{end}}{{define "content"}}
<h3>رویدادها</h3><div class="row">{{range .Events}}<div class="col-md-6 col-lg-4 mb-3" id="{{.Slug}}"><div class="card h-100">{{if .Image}}<img src="/static/{{.Image}}" alt="{{.Title}}">{{end}}<div class="card-body"><h5>{{.Title}}</h5><p>{{.Date}} — {{.Time}}</p><p>{{.Description}}</p><p class="small">ثبت‌نام شده: {{.RegisteredCount}} نفر</p>{{if .UserRegistered}}<span class="text-success">شما ثبت‌نام کرده‌اید.</span>{{else}}{{if eq .State "open"}}<button class="btn btn-primary js-event-register-wallet-btn" data-slug="{{.Slug}}" data-title="{{.Title}}">ثبت‌نام با کیف پول</button>{{end}}{{end}}</div></div></div>{{end}}</div>
<div class="card shadow-sm mt-4"><div class="card-body"><h5>ثبت‌نام‌های من</h5><ul class="list-group list-group-flush">{{range .Registrations}}<li class="list-group-item d-flex justify-content-between"><span>{{.Title}} — {{datetime .CreatedAt}}</span><span>{{.Price}} تومان</span></li>{{else}}<li class="list-group-item text-muted">ثبت‌نامی وجود ندارد.</li>{{end}}</ul></div></div>
{{end}}{{define "scripts"}}{{end}}
