{{define "title"}}اشتراک من | {{.Site.Brand}}{{end}}{{define "content"}}
<div class="d-flex justify-content-between"><h3>اشتراک من</h3><a class="btn btn-success btn-sm" href="/dashboard/wallet">موجودی: {{.Current.WalletBalance}} تومان</a></div>
<div class="card shadow-sm my-4"><div class="card-body"><h5>وضعیت فعلی</h5>{{if .Current.Active}}<p>{{with .Current.Name}}{{value .}}{{end}} — اعتبار تا {{date .Current.ExpiresAt}}</p>{{else}}<p class="text-muted">اشتراک فعالی ندارید.</p>{{end}}</div></div>
<h4>طرح‌ها</h4><div class="row">{{range .Plans}}<div class="col-md-4 mb-3"><div class="card h-100"><div class="card-body"><h5>{{.Name}}</h5><p>{{.Description}}</p><p>{{.DurationDays}} روز — {{.Price}} تومان</p><form method="post" action="/dashboard/membership/buy"><input type="hidden" name="plan_slug" value="{{.Slug}}"><button class="btn btn-primary">خرید اشتراک</button></form></div></div></div>{{end}}</div>
<div class="card shadow-sm mt-4"><div class="card-body"><h5>تاریخچه</h5><div class="table-responsive"><table class="table"><thead><tr><th>طرح</th><th>خرید</th><th>انقضا</th><th>مبلغ</th><th>وضعیت</th><th></th></tr></thead><tbody>{{range .History}}<tr><td>{{.PlanName}}</td><td>{{datetime .PurchasedAt}}</td><td>{{day .ExpiresAt}}</td><td>{{.Amount}}</td><td>{{.Status}}</td><td>{{if eq .Status "active"}}<form method="post" action="/dashboard/membership/cancel"><input type="hidden" name="history_id" value="{{.ID}}"><button class="btn btn-sm btn-outline-danger">لغو</button></form>{{end}}</td></tr>{{else}}<tr><td colspan="6" class="text-muted">سابقه‌ای وجود ندارد.</td></tr>{{end}}</tbody></table></div></div></div>
{{end}}
