{{define "title"}}تنظیمات پروفایل | {{.Site.Brand}}{{end}}{{define "content"}}
<h3>تنظیمات پروفایل</h3><div class="row g-4 mt-2"><div class="col-lg-4"><div class="card h-100"><div class="card-body"><h5>پروفایل کاربری</h5><p><strong>نام:</strong> {{value .User.FirstName}} {{value .User.LastName}}</p><p><strong>ایمیل:</strong> {{.User.Email}}</p>{{with .User.Phone}}<p><strong>موبایل:</strong> {{value .}}</p>{{end}}{{with .User.EmergencyContact}}<p><strong>تماس اضطراری:</strong> {{value .}}</p>{{end}}</div></div></div>
<div class="col-lg-8"><div class="card mb-4"><div class="card-body"><h5>اطلاعات اصلی</h5><form method="post"><input type="hidden" name="profile_action" value="profile"><div class="row g-3"><div class="col-md-6"><label>ایمیل</label><input class="form-control" type="email" name="email" required value="{{.User.Email}}"></div><div class="col-md-3"><label>نام</label><input class="form-control" name="first_name" required value="{{value .User.FirstName}}"></div><div class="col-md-3"><label>نام خانوادگی</label><input class="form-control" name="last_name" required value="{{value .User.LastName}}"></div><div class="col-md-4"><label>موبایل</label><input class="form-control" name="phone" value="{{value .User.Phone}}"></div><div class="col-md-4"><label>تاریخ تولد</label><input class="form-control" name="birthdate" value="{{value .User.Birthdate}}"></div><div class="col-md-4"><label>تماس اضطراری</label><input class="form-control" name="emergency_contact" value="{{value .User.EmergencyContact}}"></div></div><button class="btn btn-primary mt-3">ذخیره تغییرات</button></form></div></div>
<div class="card"><div class="card-body"><h5>تغییر رمز عبور</h5><form method="post"><input type="hidden" name="profile_action" value="password"><div class="row g-3"><div class="col-md-4"><input class="form-control" type="password" name="current_password" placeholder="رمز فعلی"></div><div class="col-md-4"><input class="form-control" type="password" name="new_password" placeholder="رمز جدید"></div><div class="col-md-4"><input class="form-control" type="password" name="new_password2" placeholder="تکرار رمز جدید"></div></div><button class="btn btn-outline-primary mt-3">به‌روزرسانی رمز عبور</button></form></div></div></div></div>
{{end}}
